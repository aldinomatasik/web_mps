@page
@using WebMPS.Extensions
@{
    ViewData["Title"] = "Access Restricted";
    ViewData["Subtitle"] = "";
    var homePage = User.GetHomePage();
}

<div class="white-card text-center py-5 mx-auto" style="max-width: 480px;">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 56px; height: 56px; background: #fee2e2; color: #dc2626;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>
    <h5 class="fw-bold text-dark mb-2">Access Restricted</h5>
    <p class="text-muted small mb-4">
        Your account role does not have permission to view this page.
    </p>
    <a asp-page="@homePage" class="btn btn-primary px-4 fw-semibold" style="background: #0284c7; border-color: #0284c7;">
        Go to My Page
    </a>
</div>
