@page
@model WebMPS.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>Login - Web MPS PMI AC</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            padding: 20px;
            color: #0f172a;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
            padding: 32px 28px;
        }
        .brand-badge {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 2px 8px;
            background: #0284c7;
            color: #ffffff;
            border-radius: 999px;
            letter-spacing: 0.4px;
        }
        .btn-login {
            background: #0284c7;
            border-color: #0284c7;
            font-weight: 600;
            padding: 10px 16px;
        }
        .btn-login:hover {
            background: #0369a1;
            border-color: #0369a1;
        }
        /* Hide Microsoft Edge / IE native duplicate eye icon on password fields */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear,
        input::-ms-reveal,
        input::-ms-clear {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
            pointer-events: none !important;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-2">
                @await Html.PartialAsync("_AppLogoSvg", 52)
            </div>
            <div class="d-flex align-items-center justify-content-center gap-2">
                <h4 class="fw-bold mb-0">Web MPS</h4>
                <span class="brand-badge">PMI AC</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Material Picking Slip System</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small fw-semibold mb-3" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <form id="loginForm" method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-semibold text-dark">Username</label>
                <input asp-for="Username" class="form-control" placeholder="Enter your username" autocomplete="username" autofocus required />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-dark">Password</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="Enter your password" autocomplete="current-password" required />
                    <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()" title="Show/Hide Password" style="border-color: #dee2e6;">
                        <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" />
                <label class="form-check-label small text-muted" for="rememberCheck">Keep me signed in</label>
            </div>

            <button type="submit" id="loginSubmitBtn" class="btn btn-primary btn-login w-100">
                Sign In
            </button>
        </form>
    </div>

    <script>
        function togglePassword() {
            var input = document.getElementById('passwordInput');
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        document.getElementById('loginForm').addEventListener('submit', function () {
            var btn = document.getElementById('loginSubmitBtn');
            btn.style.pointerEvents = 'none';
            btn.classList.add('opacity-75');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Signing in...';
        });
    </script>
</body>
</html>
