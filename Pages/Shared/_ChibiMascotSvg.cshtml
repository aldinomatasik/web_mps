@model (string Role, int Size)
@{
    var role = Model.Role ?? "Uploader";
    var size = Model.Size > 0 ? Model.Size : 36;
}
@if (role == WebMPS.Models.AppRoles.Admin)
{
    <!-- Admin: Commander Chibi with Gold Crown & Blue Visor -->
    <svg class="mps-chibi-svg mps-chibi-admin" width="@size" height="@size" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g class="chibi-body-group">
            <!-- Soft Aura Halo -->
            <circle cx="32" cy="34" r="24" fill="#E0E7FF" opacity="0.55" />
            <!-- Shoulders / Suit -->
            <path d="M18 57C18 48.5 24.2 44 32 44C39.8 44 46 48.5 46 57H18Z" fill="#1E40AF" />
            <path d="M27 45L32 52L37 45" fill="#FFFFFF" />
            <path d="M32 47L30.5 54H33.5L32 47Z" fill="#F59E0B" />
            <!-- Waving Hand -->
            <g class="chibi-hand">
                <circle cx="50" cy="46" r="4.2" fill="#FDE68A" stroke="#0F172A" stroke-width="1.3" />
                <circle cx="50" cy="46" r="3.4" fill="#FED7AA" />
            </g>
            <!-- Head -->
            <circle cx="32" cy="31" r="15.5" fill="#FED7AA" stroke="#1E293B" stroke-width="1.6" />
            <!-- Hair Bangs -->
            <path d="M16.5 29C16.5 20 23.5 15 32 15C40.5 15 47.5 20 47.5 29C45 25.5 41.5 24 38 25.5C35.5 22.5 29.5 22.5 26.5 25.5C23 24 19 25.5 16.5 29Z" fill="#1E293B" />
            <!-- Commander Cap Trim & Gold Crown -->
            <path d="M19 21C21 14 26 11.5 32 11.5C38 11.5 43 14 45 21H19Z" fill="#0284C7" stroke="#0F172A" stroke-width="1.4" />
            <rect x="20" y="19.5" width="24" height="3.2" rx="1.6" fill="#0EA5E9" />
            <g class="chibi-crown">
                <path d="M24 13L26 6.5L30 10L32 5L34 10L38 6.5L40 13H24Z" fill="#FACC15" stroke="#B45309" stroke-width="1.3" stroke-linejoin="round" />
                <circle cx="32" cy="5" r="1.4" fill="#FEF08A" />
            </g>
            <!-- Rosy Cheeks -->
            <ellipse cx="22.5" cy="34.5" rx="2.7" ry="1.6" fill="#FDA4AF" opacity="0.85" />
            <ellipse cx="41.5" cy="34.5" rx="2.7" ry="1.6" fill="#FDA4AF" opacity="0.85" />
            <!-- Eyes Open (Blink) -->
            <g class="chibi-eyes-open">
                <ellipse cx="26" cy="31.5" rx="2.2" ry="2.7" fill="#0F172A" />
                <ellipse cx="38" cy="31.5" rx="2.2" ry="2.7" fill="#0F172A" />
                <circle cx="25.3" cy="30.4" r="0.85" fill="#FFFFFF" />
                <circle cx="37.3" cy="30.4" r="0.85" fill="#FFFFFF" />
            </g>
            <!-- Eyes Happy (^ ^) on Hover/Click -->
            <g class="chibi-eyes-happy">
                <path d="M23.5 32C24.5 29.8 27.5 29.8 28.5 32" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
                <path d="M35.5 32C36.5 29.8 39.5 29.8 40.5 32" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
            </g>
            <!-- Smile -->
            <path d="M29 36.8C30.4 38.4 33.6 38.4 35 36.8" stroke="#9A3412" stroke-width="1.6" stroke-linecap="round" />
        </g>
        <!-- Sparkles -->
        <g class="chibi-sparkles">
            <path d="M11 16L12 13L13 16L16 17L13 18L12 21L11 18L8 17L11 16Z" fill="#FACC15" />
            <path d="M51 12L51.8 9.5L52.6 12L55 12.8L52.6 13.6L51.8 16L51 13.6L48.5 12.8L51 12Z" fill="#38BDF8" />
        </g>
    </svg>
}
else if (role == WebMPS.Models.AppRoles.Planner)
{
    <!-- Planner: Safety Helmet & Smart Glasses Chibi -->
    <svg class="mps-chibi-svg mps-chibi-planner" width="@size" height="@size" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g class="chibi-body-group">
            <circle cx="32" cy="34" r="24" fill="#E0F2FE" opacity="0.65" />
            <path d="M18 57C18 48.5 24.2 44 32 44C39.8 44 46 48.5 46 57H18Z" fill="#0284C7" />
            <path d="M27 45L32 51L37 45" fill="#F8FAFC" />
            <!-- Clipboard Badge on Side -->
            <g class="chibi-hand">
                <rect x="45" y="42" width="8.5" height="10.5" rx="1.6" fill="#FFFFFF" stroke="#0369A1" stroke-width="1.3" />
                <rect x="47.2" y="40.5" width="4" height="2.4" rx="0.8" fill="#0369A1" />
                <line x1="47" y1="46" x2="51.5" y2="46" stroke="#38BDF8" stroke-width="1.2" stroke-linecap="round" />
                <line x1="47" y1="49" x2="50.5" y2="49" stroke="#38BDF8" stroke-width="1.2" stroke-linecap="round" />
            </g>
            <!-- Head -->
            <circle cx="32" cy="32" r="15" fill="#FED7AA" stroke="#1E293B" stroke-width="1.6" />
            <!-- Hair -->
            <path d="M17.5 28C19.5 23 23 22 26 24.5C29 21.5 35 21.5 38 24.5C41 22 44.5 23 46.5 28" stroke="#334155" stroke-width="3" stroke-linecap="round" />
            <!-- White/Sky Safety Helmet -->
            <path d="M16.5 24C17.5 14 23.8 10 32 10C40.2 10 46.5 14 47.5 24H16.5Z" fill="#FFFFFF" stroke="#0284C7" stroke-width="1.6" />
            <path d="M14.5 24H49.5" stroke="#0284C7" stroke-width="2.6" stroke-linecap="round" />
            <rect x="29.5" y="10" width="5" height="13" rx="1.5" fill="#38BDF8" />
            <!-- Cheeks -->
            <ellipse cx="22.5" cy="35.5" rx="2.6" ry="1.5" fill="#FDA4AF" opacity="0.85" />
            <ellipse cx="41.5" cy="35.5" rx="2.6" ry="1.5" fill="#FDA4AF" opacity="0.85" />
            <!-- Eyes -->
            <g class="chibi-eyes-open">
                <ellipse cx="26.5" cy="32.5" rx="2" ry="2.4" fill="#0F172A" />
                <ellipse cx="37.5" cy="32.5" rx="2" ry="2.4" fill="#0F172A" />
                <circle cx="25.9" cy="31.5" r="0.8" fill="#FFFFFF" />
                <circle cx="36.9" cy="31.5" r="0.8" fill="#FFFFFF" />
            </g>
            <g class="chibi-eyes-happy">
                <path d="M24 33C25 30.8 28 30.8 29 33" stroke="#0F172A" stroke-width="1.9" stroke-linecap="round" />
                <path d="M35 33C36 30.8 39 30.8 40 33" stroke="#0F172A" stroke-width="1.9" stroke-linecap="round" />
            </g>
            <!-- Cute Glasses Rim -->
            <rect x="21.8" y="29" width="9.2" height="6.8" rx="2.5" stroke="#0F172A" stroke-width="1.3" />
            <rect x="33" y="29" width="9.2" height="6.8" rx="2.5" stroke="#0F172A" stroke-width="1.3" />
            <line x1="31" y1="32" x2="33" y2="32" stroke="#0F172A" stroke-width="1.3" />
            <!-- Smile -->
            <path d="M29.2 37.5C30.6 39 33.4 39 34.8 37.5" stroke="#9A3412" stroke-width="1.5" stroke-linecap="round" />
        </g>
        <g class="chibi-sparkles">
            <path d="M51 15L51.8 12.8L52.6 15L54.8 15.8L52.6 16.6L51.8 18.8L51 16.6L48.8 15.8L51 15Z" fill="#0EA5E9" />
        </g>
    </svg>
}
else if (role == WebMPS.Models.AppRoles.TO)
{
    <!-- TO: CS Line Receiver Chibi with Headset & Green Cap -->
    <svg class="mps-chibi-svg mps-chibi-to" width="@size" height="@size" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g class="chibi-body-group">
            <circle cx="32" cy="34" r="24" fill="#DCFCE7" opacity="0.65" />
            <path d="M18 57C18 48.5 24.2 44 32 44C39.8 44 46 48.5 46 57H18Z" fill="#15803D" />
            <path d="M27 45L32 51L37 45" fill="#ECFDF5" />
            <!-- Waving Hand -->
            <g class="chibi-hand">
                <circle cx="49.5" cy="46" r="3.6" fill="#FED7AA" stroke="#1E293B" stroke-width="1.3" />
            </g>
            <!-- Head -->
            <circle cx="32" cy="31.5" r="15" fill="#FED7AA" stroke="#1E293B" stroke-width="1.6" />
            <!-- Headset Arch & Earcups -->
            <path d="M15.5 31C15.5 18 22.8 12.5 32 12.5C41.2 12.5 48.5 18 48.5 31" stroke="#0F172A" stroke-width="2.4" stroke-linecap="round" />
            <rect x="13.5" y="27" width="4.5" height="9" rx="2.2" fill="#16A34A" stroke="#0F172A" stroke-width="1.3" />
            <rect x="46" y="27" width="4.5" height="9" rx="2.2" fill="#16A34A" stroke="#0F172A" stroke-width="1.3" />
            <path d="M46 34.5C43 38 39 39 36.5 39" stroke="#0F172A" stroke-width="1.4" stroke-linecap="round" />
            <!-- Green Work Cap -->
            <path d="M18.5 23.5C19.5 15 25 12 32 12C39 12 44.5 15 45.5 23.5H18.5Z" fill="#16A34A" stroke="#0F172A" stroke-width="1.4" />
            <path d="M17 23.5H49" stroke="#14532D" stroke-width="2.4" stroke-linecap="round" />
            <!-- Cheeks -->
            <ellipse cx="22.5" cy="35" rx="2.6" ry="1.5" fill="#FDA4AF" opacity="0.85" />
            <ellipse cx="41.5" cy="35" rx="2.6" ry="1.5" fill="#FDA4AF" opacity="0.85" />
            <!-- Eyes -->
            <g class="chibi-eyes-open">
                <ellipse cx="26" cy="31.5" rx="2.1" ry="2.6" fill="#0F172A" />
                <ellipse cx="38" cy="31.5" rx="2.1" ry="2.6" fill="#0F172A" />
                <circle cx="25.3" cy="30.5" r="0.85" fill="#FFFFFF" />
                <circle cx="37.3" cy="30.5" r="0.85" fill="#FFFFFF" />
            </g>
            <g class="chibi-eyes-happy">
                <path d="M23.5 32C24.5 29.8 27.5 29.8 28.5 32" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
                <path d="M35.5 32C36.5 29.8 39.5 29.8 40.5 32" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
            </g>
            <!-- Smile -->
            <path d="M29 37C30.5 38.6 33.5 38.6 35 37" stroke="#9A3412" stroke-width="1.6" stroke-linecap="round" />
        </g>
        <g class="chibi-sparkles">
            <path d="M12 16L12.8 13.8L13.6 16L15.8 16.8L13.6 17.6L12.8 19.8L12 17.6L9.8 16.8L12 16Z" fill="#22C55E" />
        </g>
    </svg>
}
else
{
    <!-- Uploader: Amber Helmet & Goggles Logistics Chibi -->
    <svg class="mps-chibi-svg mps-chibi-uploader" width="@size" height="@size" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g class="chibi-body-group">
            <circle cx="32" cy="34" r="24" fill="#FEF3C7" opacity="0.7" />
            <path d="M18 57C18 48.5 24.2 44 32 44C39.8 44 46 48.5 46 57H18Z" fill="#D97706" />
            <path d="M27 45L32 51L37 45" fill="#FFFBEB" />
            <!-- Mini Document Hand -->
            <g class="chibi-hand">
                <rect x="44.5" y="42" width="8.5" height="10" rx="1.5" fill="#FFFFFF" stroke="#B45309" stroke-width="1.3" />
                <path d="M48.8 49V45M48.8 45L47 46.8M48.8 45L50.6 46.8" stroke="#D97706" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </g>
            <!-- Head -->
            <circle cx="32" cy="32" r="15" fill="#FED7AA" stroke="#1E293B" stroke-width="1.6" />
            <!-- Amber Hat with Goggles -->
            <path d="M17.5 23.5C18.5 14.5 24.5 11 32 11C39.5 11 45.5 14.5 46.5 23.5H17.5Z" fill="#F59E0B" stroke="#92400E" stroke-width="1.4" />
            <rect x="21" y="17.5" width="9" height="5" rx="2.5" fill="#E0F2FE" stroke="#78350F" stroke-width="1.3" />
            <rect x="34" y="17.5" width="9" height="5" rx="2.5" fill="#E0F2FE" stroke="#78350F" stroke-width="1.3" />
            <line x1="30" y1="20" x2="34" y2="20" stroke="#78350F" stroke-width="1.4" />
            <!-- Cheeks -->
            <ellipse cx="22.5" cy="35.5" rx="2.6" ry="1.5" fill="#FDA4AF" opacity="0.85" />
            <ellipse cx="41.5" cy="35.5" rx="2.6" ry="1.5" fill="#FDA4AF" opacity="0.85" />
            <!-- Eyes -->
            <g class="chibi-eyes-open">
                <ellipse cx="26" cy="32" rx="2.1" ry="2.6" fill="#0F172A" />
                <ellipse cx="38" cy="32" rx="2.1" ry="2.6" fill="#0F172A" />
                <circle cx="25.3" cy="31" r="0.85" fill="#FFFFFF" />
                <circle cx="37.3" cy="31" r="0.85" fill="#FFFFFF" />
            </g>
            <g class="chibi-eyes-happy">
                <path d="M23.5 32.5C24.5 30.3 27.5 30.3 28.5 32.5" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
                <path d="M35.5 32.5C36.5 30.3 39.5 30.3 40.5 32.5" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
            </g>
            <!-- Smile -->
            <path d="M29 37.2C30.5 38.8 33.5 38.8 35 37.2" stroke="#9A3412" stroke-width="1.6" stroke-linecap="round" />
        </g>
        <g class="chibi-sparkles">
            <path d="M51 15L51.8 12.8L52.6 15L54.8 15.8L52.6 16.6L51.8 18.8L51 16.6L48.8 15.8L51 15Z" fill="#F59E0B" />
        </g>
    </svg>
}
