@page "/Audit"
@using WebMPS.Models
@using WebMPS.Extensions
@model WebMPS.Pages.AuditModel
@{
    ViewData["Title"] = "Audit History";
    ViewData["Subtitle"] = "";
}

<!-- Filter Bar: Compact Single-Row Toolbar (TO, Planner, Category, Date) -->
<div class="filter-bar no-print py-2 px-3 mb-3 shadow-xs" style="padding: 10px 16px; margin-bottom: 16px; border-radius: 10px;">
    <form method="get" class="w-100 d-flex flex-wrap flex-lg-nowrap align-items-center gap-2">
        <!-- 1. Filter TO -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">TO:</span>
            <select name="To" class="form-select form-select-sm" style="width: 135px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.To) || Model.To == "ALL")">All Lines</option>
                @foreach (var t in Model.DistinctToList)
                {
                    <option value="@t" selected="@(Model.To == t)">@t</option>
                }
            </select>
        </div>

        <!-- 2. Filter Planner -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">Planner:</span>
            <select name="Planner" class="form-select form-select-sm" style="width: 135px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.Planner) || Model.Planner == "ALL")">All Planners</option>
                @foreach (var p in Model.DistinctPlanners)
                {
                    <option value="@p" selected="@(Model.Planner == p)">@p</option>
                }
            </select>
        </div>

        <!-- 3. Filter Category (1A, 1B, 2) -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">Category:</span>
            <select name="Category" class="form-select form-select-sm" style="width: 105px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.Category) || Model.Category == "ALL")">All Types</option>
                @foreach (var c in Model.DistinctCategories)
                {
                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                }
            </select>
        </div>

        <!-- 4. Filter Date (Calendar) -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">Date:</span>
            <div class="input-group input-group-sm" style="width: 140px;">
                <input type="date" 
                       id="auditDate"
                       name="Date" 
                       class="form-control form-control-sm px-2" 
                       value="@Model.FormattedDateInput" 
                       onchange="this.form.submit()" 
                       title="Select date (yesterday, today, tomorrow, etc.)" 
                       style="cursor: pointer; height: 31px;" />
                @if (!string.IsNullOrEmpty(Model.FormattedDateInput))
                {
                    <button type="button" 
                            class="btn btn-outline-secondary btn-sm px-2" 
                            onclick="clearDateFilter(this.form)" 
                            title="Show all dates">✕</button>
                }
            </div>
        </div>

        <!-- Reset Button -->
        <div class="d-flex align-items-center gap-2 ms-auto">
            @if (!string.Equals(Model.Date, Model.TodayDate, StringComparison.OrdinalIgnoreCase) || 
                 (!string.IsNullOrEmpty(Model.To) && Model.To != "ALL") || 
                 (!string.IsNullOrEmpty(Model.Planner) && Model.Planner != "ALL") ||
                 (!string.IsNullOrEmpty(Model.Category) && Model.Category != "ALL"))
            {
                <a asp-page="/Audit" class="btn btn-outline-secondary btn-sm px-2" title="Reset All Filters (Back to Today)">✕</a>
            }
        </div>
    </form>
</div>

<!-- Quick Info Strip -->
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted small">Showing <strong>@Model.Slips.Count</strong> of <strong>@Model.TotalSlips</strong> slips</span>
        @if (!string.IsNullOrEmpty(Model.To) && Model.To != "ALL")
        {
            <span class="badge bg-light text-dark border">TO: @Model.To</span>
        }
        @if (!string.IsNullOrEmpty(Model.Planner) && Model.Planner != "ALL")
        {
            <span class="badge bg-light text-dark border">Planner: @Model.Planner</span>
        }
        @if (!string.IsNullOrEmpty(Model.Category) && Model.Category != "ALL")
        {
            <span class="badge bg-light text-primary border fw-bold">Category: @Model.Category</span>
        }
        @if (!string.IsNullOrEmpty(Model.Date) && Model.Date != "ALL")
        {
            <span class="badge bg-light text-primary border">Date: @Model.Date</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a href="/download/all" target="_blank" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download All Slips (PDF)
        </a>
    </div>
</div>

@if (Model.Slips.Count == 0)
{
    <div class="white-card text-center py-5">
        <div class="mb-3 text-muted">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
                <rect x="9" y="3" width="6" height="4" rx="2"></rect>
                <path d="m9 14 2 2 4-4"></path>
            </svg>
        </div>
        <h5 class="fw-bold text-dark">No Audited Slips Found</h5>
        <p class="text-muted small">No material slips have been fully approved by both Delivery & Receiver for the selected filters.</p>
        <a asp-page="/Audit" asp-route-Date="ALL" class="btn btn-sm btn-outline-primary mt-2">Show All Dates</a>
    </div>
}
else
{
    <!-- Slip Cards 2-Column Grid (Exact Same Structure as Slips.cshtml) -->
    <div class="row row-cols-1 row-cols-lg-2 g-4 mb-4">
        @foreach (var slip in Model.Slips)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border mps-hover-card" id="slip-card-@slip.Id">
                    <!-- Slip Card Header Bar -->
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2 px-3 no-print">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-dark font-monospace fs-6">#@slip.SlipNumber</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/download/slip/@slip.Id" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem; padding: 2px 8px;">
                                Original PDF
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem; padding: 2px 8px;" onclick="printSlip('@slip.Id')">
                                Print
                            </button>
                        </div>
                    </div>

                    <!-- Slip Card Body: Exact Document Representation -->
                    <div class="card-body p-3 d-flex flex-column justify-content-between" id="slip-print-@slip.Id">
                        <div class="mps-slip-paper">
                            <!-- Header Row: Title & Boxed Tag -->
                            <div class="mps-header-row">
                                <div class="mps-title">@slip.Title</div>
                                <div class="mps-tag-box">@slip.Tag</div>
                            </div>

                            <!-- Metadata Grid: 2 Columns -->
                            <div class="mps-meta-grid">
                                <div class="mps-meta-item">
                                    <span class="mps-label">PLANNER:</span>
                                    <span class="mps-val">@slip.Planner</span>
                                </div>
                                <div></div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">SLIP NUMBER:</span>
                                    <span class="mps-val font-monospace">@slip.SlipNumber</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">SUPPLY DATE:</span>
                                    <span class="mps-val">@slip.SupplyDate</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">FROM:</span>
                                    <span class="mps-val">@slip.FromLocation</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">REQ. DATE:</span>
                                    <span class="mps-val">@slip.ReqDate</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">TO:</span>
                                    <span class="mps-val">@slip.ToLocation</span>
                                </div>
                                <div></div>
                            </div>

                            <!-- Primary Part Section Table -->
                            <table class="mps-section-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;">PART CODE</th>
                                        <th style="width: 45%;">DESCRIPTION</th>
                                        <th style="width: 18%; text-align: right;">QTY</th>
                                        <th style="width: 12%; text-align: right;">UNIT</th>
                                    </tr>
                                    <tr class="mps-sub-head">
                                        <th>VMI &nbsp;&nbsp; VENDOR</th>
                                        <th>VENDOR DESCRIPTION</th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@slip.PartCode</td>
                                        <td>@slip.PartDescription</td>
                                        <td style="text-align: right;">@slip.Qty.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        <td style="text-align: right;">@slip.Unit</td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Pegged Orders Section Table -->
                            <table class="mps-section-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;">ORDER</th>
                                        <th style="width: 45%;">PEGGED MATERIAL</th>
                                        <th style="width: 18%; text-align: right;">REQ</th>
                                        <th style="width: 12%; text-align: right;">UNIT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in slip.PeggedOrders)
                                    {
                                        <tr>
                                            <td>@order.OrderNumber</td>
                                            <td>@order.PeggedMaterial</td>
                                            <td style="text-align: right;">@order.ReqQty.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td style="text-align: right;">@order.Unit</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <!-- Dual Signature Boxes (Exact Border Structure) -->
                            <div class="mps-sig-container">
                                <div class="mps-sig-box">
                                    <div class="mps-sig-title">DELIVERY SIGNATURE</div>
                                    <div class="mps-sig-content">
                                        <div class="mps-sig-name" title="@slip.DeliverySignature">
                                            @slip.DeliverySignature
                                        </div>
                                        <div class="mps-sig-date">
                                            <span>@((slip.ScannedAt ?? slip.ApprovedAt)?.ToString("dd/MM/yyyy") ?? slip.SupplyDate)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mps-sig-box">
                                    <div class="mps-sig-title">RECEIVER SIGNATURE</div>
                                    <div class="mps-sig-content">
                                        <div class="mps-sig-name" title="@slip.ReceiverSignature">
                                            @slip.ReceiverSignature
                                        </div>
                                        <div class="mps-sig-date">
                                            <span>@(slip.ApprovedAt?.ToString("dd/MM/yyyy") ?? slip.SupplyDate)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Barcode Section -->
                            <div class="mps-barcode-container">
                                @Html.Raw(WebMPS.Services.BarcodeHelper.GenerateSvgBarcode(slip.Barcode, 26))
                                <div class="mps-barcode-text">@slip.SlipNumber</div>
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center no-print">
                            <span class="text-muted small">
                                <span class="text-success fw-bold">✓ Approved by @(slip.ReceiverSignature ?? slip.ApprovedBy) (@(slip.ApprovedAt?.ToString("dd/MM/yy") ?? slip.SupplyDate))</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center my-4 no-print">
            <ul class="pagination pagination-sm shadow-sm">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Audit" 
                       asp-route-PageIndex="@(Model.PageIndex - 1)" 
                       asp-route-To="@Model.To" 
                       asp-route-Planner="@Model.Planner" 
                       asp-route-Category="@Model.Category" 
                       asp-route-Date="@Model.Date">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                    {
                        <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                            <a class="page-link" asp-page="/Audit" 
                               asp-route-PageIndex="@i" 
                               asp-route-To="@Model.To" 
                               asp-route-Planner="@Model.Planner" 
                               asp-route-Category="@Model.Category" 
                               asp-route-Date="@Model.Date">@i</a>
                        </li>
                    }
                    else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/Audit" 
                       asp-route-PageIndex="@(Model.PageIndex + 1)" 
                       asp-route-To="@Model.To" 
                       asp-route-Planner="@Model.Planner" 
                       asp-route-Category="@Model.Category" 
                       asp-route-Date="@Model.Date">Next</a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
<script>
    function clearDateFilter(form) {
        if (!form) form = document.querySelector('.filter-bar form');
        const dateInput = form.querySelector('input[name="Date"]');
        if (dateInput) {
            dateInput.value = '';
        }
        form.submit();
    }

    function printSlip(slipId) {
        var slipEl = document.getElementById('slip-print-' + slipId);
        if (!slipEl) return;

        var oldFrame = document.getElementById('mps-print-frame');
        if (oldFrame) oldFrame.remove();

        var iframe = document.createElement('iframe');
        iframe.id = 'mps-print-frame';
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        document.body.appendChild(iframe);

        var styles = Array.from(document.querySelectorAll('style')).map(function (s) { return s.outerHTML; }).join('');
        var doc = iframe.contentWindow.document;

        doc.open();
        doc.write('<!DOCTYPE html><html><head><title></title>' + styles +
            '<style>' +
            '@@page { size: auto; margin: 0mm !important; }' +
            '* { box-sizing: border-box !important; }' +
            'html, body { margin: 0 !important; padding: 0 !important; background: #ffffff !important; width: 100% !important; }' +
            'body { padding: 12mm 14mm !important; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif !important; }' +
            '.mps-slip-paper { width: 100% !important; max-width: 560px !important; margin: 0 auto !important; padding: 0 !important; border: none !important; box-shadow: none !important; }' +
            '</style></head><body>' + slipEl.outerHTML + '</body></html>');
        doc.close();

        setTimeout(function () {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
        }, 250);
    }
</script>
}
