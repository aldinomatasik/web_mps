{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy to Production Server (CI/CD)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/deploy.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Build Release Only",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "-c", "Release"],
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
