@page
@using WebMPS.Models
@model WebMPS.Pages.UsersModel
@{
    ViewData["Title"] = "Manage Users";
    ViewData["Subtitle"] = "";
}

@if (!string.IsNullOrEmpty(Model.FeedbackMessage))
{
    <div class="alert alert-@Model.FeedbackType alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <svg width="20" height="20" style="width:20px;height:20px;min-width:20px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <div class="fw-semibold">@Model.FeedbackMessage</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary KPI Cards (with Hover Animation) -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="white-card p-3 mb-0 d-flex align-items-center gap-3 mps-hover-card">
            <div class="p-3 rounded-3" style="background: #e0f2fe; color: #0284c7;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Total Accounts</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="white-card p-3 mb-0 d-flex align-items-center gap-3 mps-hover-card">
            <div class="p-3 rounded-3" style="background: #dcfce7; color: #16a34a;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Active Users</div>
                <div class="fs-4 fw-bold text-success" id="kpi-active-users">@Model.ActiveUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="white-card p-3 mb-0 d-flex align-items-center gap-3 mps-hover-card">
            <div class="p-3 rounded-3" style="background: #eef2ff; color: #2563eb;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <circle cx="9" cy="10" r="2"></circle>
                    <path d="M15 8h2"></path>
                    <path d="M15 12h2"></path>
                    <path d="M7 16h10"></path>
                </svg>
            </div>
            <div>
                <div class="text-muted small fw-semibold">TO &amp; Planners</div>
                <div class="fs-4 fw-bold text-primary">@Model.FieldStaffCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="white-card p-3 mb-0 d-flex align-items-center gap-3 mps-hover-card">
            <div class="p-3 rounded-3" style="background: #fef3c7; color: #d97706;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Admin &amp; Uploader</div>
                <div class="fs-4 fw-bold text-warning">@Model.AdminUploaderCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter & Add User Bar -->
<div class="filter-bar">
    <form method="get" class="d-flex flex-wrap align-items-center gap-3 flex-grow-1">
        <div class="d-flex align-items-center gap-2">
            <label class="fw-bold text-dark small text-nowrap mb-0">Role:</label>
            <select name="RoleFilter" class="form-select form-select-sm fw-semibold" style="min-width: 150px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.RoleFilter) || Model.RoleFilter == "ALL")">All Roles (@Model.TotalUsers)</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                <option value="Uploader" selected="@(Model.RoleFilter == "Uploader")">Uploader</option>
                <option value="TO" selected="@(Model.RoleFilter == "TO")">TO</option>
                <option value="Planner" selected="@(Model.RoleFilter == "Planner")">Planner</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <input type="text" name="Search" class="form-control form-control-sm" placeholder="Search username / name / scope..." value="@Model.Search" style="width: 240px;" />
            <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
            @if ((!string.IsNullOrEmpty(Model.RoleFilter) && Model.RoleFilter != "ALL") || !string.IsNullOrEmpty(Model.Search))
            {
                <a asp-page="/Users" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </div>
    </form>

    <button type="button" class="btn btn-sm btn-primary fw-semibold px-3 py-2 d-inline-flex align-items-center gap-1" style="background: #0284c7; border-color: #0284c7;" onclick="openCreateUserModal()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add New User
    </button>
</div>

<!-- User Accounts Card Grid -->
@if (!Model.Users.Any())
{
    <div class="white-card text-center py-5">
        <h5 class="fw-bold text-dark mb-1">No User Accounts Found</h5>
        <p class="text-muted small mb-3">Try resetting your filter or create a new user account.</p>
        <button type="button" class="btn btn-sm btn-primary" style="background: #0284c7;" onclick="openCreateUserModal()">+ Add New User</button>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var u in Model.Users)
        {
            bool isSelf = u.Id == Model.CurrentUserId;
            string roleKey = u.Role.ToLowerInvariant();
            string roleBadgeClass = u.Role switch
            {
                AppRoles.Admin => "background: linear-gradient(135deg, #0284c7, #2563eb); color: #ffffff;",
                AppRoles.Planner => "background: #0284c7; color: #ffffff;",
                AppRoles.TO => "background: #16a34a; color: #ffffff;",
                _ => "background: #d97706; color: #ffffff;"
            };
            string scopeDisplay = u.Role switch
            {
                AppRoles.Admin => "Full Access (All Pages & Users)",
                AppRoles.Uploader => "Upload MPS Document Only",
                AppRoles.TO => string.IsNullOrWhiteSpace(u.AssignedScope) ? "-" : $"TO: {u.AssignedScope}",
                AppRoles.Planner => string.IsNullOrWhiteSpace(u.AssignedScope) ? "-" : $"Planner: {u.AssignedScope}",
                _ => "-"
            };

            <div class="col-xl-4 col-md-6 col-12">
                <div class="card border h-100 shadow-sm bg-white mps-slip-card @(!u.IsActive ? "opacity-75" : "")" id="user-card-@u.Id">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Top Row: Chibi Mascot + Identity + Status -->
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="mps-avatar-ring flex-shrink-0 mps-stage-@roleKey" style="width: 52px; height: 52px; border: 2px solid #e2e8f0;">
                                    @await Html.PartialAsync("_ChibiMascotSvg", (u.Role, 44))
                                </div>
                                <div class="min-w-0 flex-grow-1">
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <span class="fw-bold text-dark text-truncate" style="font-size: 0.96rem;">@u.DisplayName</span>
                                        @if (isSelf)
                                        {
                                            <span class="badge bg-light text-primary border" style="font-size: 0.65rem;">You</span>
                                        }
                                    </div>
                                    <div class="text-muted small font-monospace">@@@u.Username</div>
                                </div>
                                <span class="badge rounded-pill px-2 py-1" style="font-size: 0.7rem; @roleBadgeClass">
                                    @if (u.Role == AppRoles.Admin)
                                    {
                                        <span>★ </span>
                                    }
                                    @u.Role
                                </span>
                            </div>

                            <!-- Scope & Signature Info -->
                            <div class="p-2 rounded-3 bg-light border mb-3" style="font-size: 0.78rem;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted">Access / Scope</span>
                                    <span id="user-status-badge-@u.Id" class="d-inline-flex align-items-center gap-1 fw-semibold @(u.IsActive ? "text-success" : "text-secondary")" style="font-size: 0.74rem;">
                                        @if (u.IsActive)
                                        {
                                            <span class="mps-online-dot" style="width: 6px; height: 6px;"></span>
                                            <span>Active</span>
                                        }
                                        else
                                        {
                                            <span>● Disabled</span>
                                        }
                                    </span>
                                </div>
                                <div class="fw-semibold text-dark text-truncate" title="@scopeDisplay">@scopeDisplay</div>
                            </div>
                        </div>

                        <!-- Card Actions -->
                        <div class="d-flex justify-content-between align-items-center gap-2 pt-2 border-top">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary flex-grow-1 fw-semibold"
                                    data-user-id="@u.Id"
                                    data-username="@u.Username"
                                    data-display-name="@u.DisplayName"
                                    data-role="@u.Role"
                                    data-scope="@u.AssignedScope"
                                    data-active="@(u.IsActive ? "true" : "false")"
                                    data-is-self="@(isSelf ? "true" : "false")"
                                    onclick="openEditUserModal(this)">
                                Edit / Password
                            </button>

                            @if (!isSelf)
                            {
                                <form method="post" asp-page-handler="ToggleActiveAjax" class="d-inline m-0" onsubmit="return toggleUserStatusAjax(event, '@u.Id', this);">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" id="toggle-user-btn-@u.Id"
                                            class="btn btn-sm @(u.IsActive ? "btn-outline-secondary" : "btn-success fw-semibold")">
                                        @(u.IsActive ? "Disable" : "Activate")
                                    </button>
                                </form>

                                <form method="post" asp-page-handler="Delete" class="d-inline m-0" onsubmit="return confirm('Delete account @u.Username permanently?');">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
                                    <input type="hidden" name="Search" value="@Model.Search" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete user">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border py-2 px-2" style="font-size: 0.72rem;">Current Session</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Shared Create / Edit User Modal -->
<div class="modal fade" id="userFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
            <div class="modal-header bg-light border-bottom">
                <h6 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="userModalTitle">
                    Add New User
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" id="userModalForm" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="modalUserId" />
                    <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
                    <input type="hidden" name="Search" value="@Model.Search" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Role <span class="text-danger">*</span></label>
                        <select name="role" id="modalRole" class="form-select" required onchange="onModalRoleChange()">
                            <option value="Planner">Planner (Handover Approval)</option>
                            <option value="TO">TO (Slip MPS Receiver)</option>
                            <option value="Uploader">Uploader (Upload PDF Only)</option>
                            <option value="Admin">Admin (Full System Access)</option>
                        </select>
                        <div class="form-text small" id="modalRoleHint"></div>
                    </div>

                    <div id="modalScopeGroup" class="mb-3">
                        <label class="form-label small fw-bold text-dark">Assigned Scope (Exact PDF Name) <span class="text-danger">*</span></label>
                        <input type="text" name="assignedScope" id="modalScope" class="form-control" placeholder="e.g. R02 (FEBY) or H100 (CS LINE)" list="scopeSuggestions" />
                        <datalist id="scopeSuggestions">
                            @foreach (var pl in Model.DistinctPlanners)
                            {
                                <option value="@pl"></option>
                            }
                            @foreach (var toLoc in Model.DistinctToLocations)
                            {
                                <option value="@toLoc"></option>
                            }
                        </datalist>
                        <div id="quickScopeChips" class="d-flex flex-wrap gap-1 mt-2"></div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold text-dark">Username <span class="text-danger">*</span></label>
                            <input type="text" name="username" id="modalUsername" class="form-control" placeholder="e.g. feby" autocomplete="off" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold text-dark">Display / Signature Name <span class="text-danger">*</span></label>
                            <input type="text" name="displayName" id="modalDisplayName" class="form-control" placeholder="e.g. R02 (FEBY)" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark" id="modalPasswordLabel">Password <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="password" name="password" id="modalPassword" class="form-control" placeholder="Min. 4 characters" autocomplete="new-password" minlength="4" />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleModalPwd()" title="Show/Hide">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <div class="form-text small" id="modalPasswordHint"></div>
                    </div>

                    <div class="form-check form-switch" id="modalActiveWrap">
                        <input class="form-check-input" type="checkbox" name="isActive" id="modalIsActive" value="true" checked />
                        <label class="form-check-label small fw-semibold text-dark" for="modalIsActive">Account Active (Can Sign In)</label>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="userModalSaveBtn" class="btn btn-sm btn-primary px-4 fw-semibold" style="background: #0284c7; border-color: #0284c7;">
                        Save User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const knownPlanners = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistinctPlanners));
    const knownTos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistinctToLocations));

    function toggleModalPwd() {
        const el = document.getElementById('modalPassword');
        el.type = el.type === 'password' ? 'text' : 'password';
    }

    function onModalRoleChange() {
        const role = document.getElementById('modalRole').value;
        const scopeGroup = document.getElementById('modalScopeGroup');
        const scopeInput = document.getElementById('modalScope');
        const roleHint = document.getElementById('modalRoleHint');
        const chipsBox = document.getElementById('quickScopeChips');

        chipsBox.innerHTML = '';

        if (role === 'Planner' || role === 'TO') {
            scopeGroup.classList.remove('d-none');
            scopeInput.required = true;
            roleHint.textContent = role === 'Planner'
                ? 'Sees only Handover Approval slips for their assigned Planner name & signs Delivery Signature.'
                : 'Sees only Slip MPS for their assigned TO location & signs Receiver Signature.';

            const suggestions = role === 'Planner' ? knownPlanners : knownTos;
            suggestions.forEach(function (val) {
                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'btn btn-xs btn-outline-primary py-0 px-2 rounded-pill';
                chip.style.fontSize = '0.72rem';
                chip.textContent = val;
                chip.addEventListener('click', function () {
                    scopeInput.value = val;
                    const disp = document.getElementById('modalDisplayName');
                    if (!disp.value.trim()) disp.value = val;
                });
                chipsBox.appendChild(chip);
            });
        } else {
            scopeGroup.classList.add('d-none');
            scopeInput.required = false;
            scopeInput.value = '';
            roleHint.textContent = role === 'Admin'
                ? 'Full access to Upload MPS, Slip MPS, Handover Approval, and Manage Users.'
                : 'Restricted to Upload MPS PDF documents only.';
        }
    }

    function openCreateUserModal() {
        const form = document.getElementById('userModalForm');
        form.setAttribute('action', '/Users?handler=Create');
        document.getElementById('userModalTitle').textContent = 'Add New User Account';
        document.getElementById('modalUserId').value = '';
        document.getElementById('modalUsername').value = '';
        document.getElementById('modalDisplayName').value = '';
        document.getElementById('modalRole').value = 'Planner';
        document.getElementById('modalRole').disabled = false;
        document.getElementById('modalScope').value = '';
        document.getElementById('modalIsActive').checked = true;
        document.getElementById('modalIsActive').disabled = false;
        document.getElementById('modalPassword').value = '';
        document.getElementById('modalPassword').required = true;
        document.getElementById('modalPasswordLabel').innerHTML = 'Password <span class="text-danger">*</span>';
        document.getElementById('modalPasswordHint').textContent = 'Minimum 4 characters.';
        onModalRoleChange();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('userFormModal')).show();
    }

    function openEditUserModal(btn) {
        const d = btn.dataset;
        const form = document.getElementById('userModalForm');
        form.setAttribute('action', '/Users?handler=Edit');
        document.getElementById('userModalTitle').textContent = 'Edit User: ' + d.displayName;
        document.getElementById('modalUserId').value = d.userId || '';
        document.getElementById('modalUsername').value = d.username || '';
        document.getElementById('modalDisplayName').value = d.displayName || '';
        document.getElementById('modalRole').value = d.role || 'Planner';
        document.getElementById('modalScope').value = d.scope || '';
        document.getElementById('modalIsActive').checked = d.active === 'true';

        const isSelf = d.isSelf === 'true';
        document.getElementById('modalIsActive').disabled = isSelf;

        document.getElementById('modalPassword').value = '';
        document.getElementById('modalPassword').required = false;
        document.getElementById('modalPasswordLabel').textContent = 'New Password (Optional)';
        document.getElementById('modalPasswordHint').textContent = 'Leave blank to keep existing password.';

        onModalRoleChange();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('userFormModal')).show();
    }

    document.getElementById('userModalForm').addEventListener('submit', function () {
        const saveBtn = document.getElementById('userModalSaveBtn');
        saveBtn.style.pointerEvents = 'none';
        saveBtn.classList.add('opacity-75');
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving...';
    });

    async function toggleUserStatusAjax(event, userId, form) {
        event.preventDefault();
        const btn = document.getElementById('toggle-user-btn-' + userId);
        const card = document.getElementById('user-card-' + userId);
        const statusBadge = document.getElementById('user-status-badge-' + userId);
        const kpiActive = document.getElementById('kpi-active-users');
        if (!btn) return false;

        btn.disabled = true;
        try {
            const resp = await fetch('?handler=ToggleActiveAjax', {
                method: 'POST',
                body: new FormData(form)
            });
            if (!resp.ok) { form.submit(); return false; }

            const data = await resp.json();
            if (data.success) {
                if (data.isActive) {
                    card?.classList.remove('opacity-75');
                    btn.className = 'btn btn-sm btn-outline-secondary';
                    btn.textContent = 'Disable';
                    if (statusBadge) {
                        statusBadge.className = 'd-inline-flex align-items-center gap-1 fw-semibold text-success';
                        statusBadge.innerHTML = '<span class="mps-online-dot" style="width: 6px; height: 6px;"></span><span>Active</span>';
                    }
                    if (kpiActive) kpiActive.textContent = parseInt(kpiActive.textContent || '0', 10) + 1;
                } else {
                    card?.classList.add('opacity-75');
                    btn.className = 'btn btn-sm btn-success fw-semibold';
                    btn.textContent = 'Activate';
                    if (statusBadge) {
                        statusBadge.className = 'd-inline-flex align-items-center gap-1 fw-semibold text-secondary';
                        statusBadge.innerHTML = '<span>● Disabled</span>';
                    }
                    if (kpiActive) kpiActive.textContent = Math.max(0, parseInt(kpiActive.textContent || '1', 10) - 1);
                }

                if (card) {
                    card.classList.remove('mps-row-flash');
                    void card.offsetWidth;
                    card.classList.add('mps-row-flash');
                }
                if (typeof celebrateMpsAvatar === 'function') celebrateMpsAvatar();
            }
        } catch (err) {
            console.error(err);
            form.submit();
        } finally {
            btn.disabled = false;
        }
        return false;
    }

    @if (Model.FeedbackType == "success")
    {
        <text>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof celebrateMpsAvatar === 'function') celebrateMpsAvatar();
        });
        </text>
    }
</script>
}
