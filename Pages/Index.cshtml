@page
@using WebMPS.Models
@model WebMPS.Pages.IndexModel
@{
    ViewData["Title"] = "Upload MPS";
    ViewData["Subtitle"] = "";
    bool isAdmin = User.IsInRole(AppRoles.Admin);
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <div class="fw-semibold">@Model.SuccessMessage</div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="fw-semibold">@Model.ErrorMessage</div>
    </div>
}

<!-- Intuitive 2-Step Workflow Guide -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="p-3 rounded-3 border bg-white d-flex align-items-center gap-3 shadow-sm mps-hover-card">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white fs-5" style="width: 40px; height: 40px; background: #0284c7; flex-shrink: 0;">
                1
            </div>
            <div>
                <div class="fw-bold text-dark">Step 1: Upload MPS Document</div>
                <div class="text-muted small">Select or drag &amp; drop one or multiple PDF files (4 slips per A4 sheet). The system automatically crops and saves individual slips to the database.</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="p-3 rounded-3 border bg-white d-flex align-items-center gap-3 shadow-sm mps-hover-card">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white fs-5" style="width: 40px; height: 40px; background: #16a34a; flex-shrink: 0;">
                2
            </div>
            <div>
                <div class="fw-bold text-dark">Step 2: Check & Approve in Slip MPS</div>
                <div class="text-muted small">Open <strong>Slip MPS</strong> to review barcodes and click <strong>Approve</strong> for material handover.</div>
            </div>
        </div>
    </div>
</div>

<!-- Main Upload Card -->
<div class="white-card mb-4">
    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
        <div>
            <h5 class="fw-bold text-dark mb-1">Upload MPS Document (PDF)</h5>
            <p class="text-muted small mb-0">Original format: 4 Slips per A4 sheet (2×2 grid). Supports single or batch multi-file PDF upload.</p>
        </div>
        <span class="badge bg-light text-primary border px-3 py-2">PDF Only • Multi-File</span>
    </div>

    <form id="uploadForm" method="post" enctype="multipart/form-data" asp-page-handler="Upload">
        <!-- Big Clickable Drag & Drop Zone -->
        <div id="dropZone"
             class="p-4 mb-3 text-center rounded-3 bg-light"
             style="border: 2px dashed #93c5fd; cursor: pointer; transition: all 0.2s;"
             onclick="document.getElementById('fileInput').click()">
            <div style="pointer-events: none;">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.8" class="mb-3">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <h5 id="dropZoneTitle" class="fw-bold text-dark mb-1">Select or Drag &amp; Drop MPS PDF Files Here</h5>
                <p class="text-muted small mb-2">Drag multiple files at once or click to browse • e.g. <code>MPS_05112026 120937 PM.pdf</code></p>
                <span class="badge bg-white text-secondary border px-2 py-1" style="font-weight: 500;">Supports multiple .pdf files</span>
            </div>
            <input type="file" id="fileInput" name="UploadFiles" accept=".pdf,application/pdf" multiple class="d-none" />
        </div>

        <!-- Inline Validation / Ignored File Warning -->
        <div id="dropWarning" class="alert alert-warning py-2 px-3 small d-none mb-3" role="alert"></div>

        <!-- Queued Multi-File List -->
        <div id="fileQueueContainer" class="border rounded-3 bg-white mb-3 d-none" style="border-color: #dbeafe !important;">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom rounded-top">
                <div id="fileQueueSummary" class="fw-semibold text-primary small"></div>
                <button type="button" id="clearQueueBtn" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-semibold">
                    Clear All
                </button>
            </div>
            <div id="fileQueueList" style="max-height: 210px; overflow-y: auto;"></div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex gap-2">
                @if (isAdmin)
                {
                    <a asp-page="/Slips" class="btn btn-outline-primary d-inline-flex align-items-center gap-1">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        Open Slip MPS
                    </a>
                    <a asp-page="/Approval" class="btn btn-outline-success d-inline-flex align-items-center gap-1">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Open Handover Approval
                    </a>
                }
            </div>

            <button type="submit" id="uploadSubmitBtn" class="btn btn-primary px-4 py-2 fw-semibold" style="background: #0284c7; border-color: #0284c7;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
                <span id="uploadSubmitText">Upload &amp; Auto Split (4 to 1)</span>
            </button>
        </div>
    </form>

    <hr class="my-4 text-muted" />

    <!-- Quick Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="text-muted small">Server Default File: <code>MPS_05112026 120937 PM.pdf</code></span>
        </div>
        <div class="d-flex gap-2">
            <form method="post" asp-page-handler="ReloadDefault" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-primary bg-white">
                    🔄 Reload Default File
                </button>
            </form>
            @if (isAdmin)
            {
                <form method="post" asp-page-handler="Clear" class="d-inline" onsubmit="return confirm('Are you sure you want to clear all data in the database?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger bg-white">
                        🗑️ Clear Database
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<!-- Upload History (SQL Server) -->
<div class="white-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
                Upload History
            </h6>
        </div>
        <span class="badge bg-light text-dark border">@Model.UploadHistory.Count Recorded</span>
    </div>

    @if (Model.UploadHistory.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th>Upload Date</th>
                        <th>File Name</th>
                        <th>File Size</th>
                        <th>Total Slips</th>
                        <th>Uploader</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int historyIdx = 1;
                    }
                    @foreach (var file in Model.UploadHistory)
                    {
                        <tr>
                            <td class="text-muted">@(historyIdx++)</td>
                            <td>@file.UploadedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                <div class="fw-bold text-dark">@file.FileName</div>
                            </td>
                            <td>@((file.FileSizeBytes / 1024.0 / 1024.0).ToString("0.00")) MB</td>
                            <td><span class="badge bg-primary">@file.TotalSlips Slips</span></td>
                            <td><span class="text-muted">@file.UploadedBy</span></td>
                            <td><span class="badge bg-success" style="font-size:0.75rem;">@file.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted small">
            No upload history recorded yet.
        </div>
    }
</div>

@section Scripts {
<style>
    #dropZone:hover,
    #dropZone.dropzone-active {
        border-color: #0284c7 !important;
        background: #f0f9ff !important;
    }
    #dropZone.dropzone-active {
        background: #e0f2fe !important;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.14);
        transform: scale(1.005);
    }
    #dropZone.dropzone-error {
        border-color: #dc2626 !important;
        background: #fef2f2 !important;
    }
    .queue-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 12px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.85rem;
    }
    .queue-item:last-child {
        border-bottom: none;
    }
    .queue-item-remove {
        border: none;
        background: transparent;
        color: #94a3b8;
        font-weight: 700;
        font-size: 1rem;
        line-height: 1;
        padding: 2px 6px;
        border-radius: 4px;
        cursor: pointer;
    }
    .queue-item-remove:hover {
        color: #dc2626;
        background: #fee2e2;
    }
</style>
<script>
    (function () {
        const MAX_BATCH_BYTES = 104857600; // 100 MB
        const dropZone = document.getElementById('dropZone');
        const dropZoneTitle = document.getElementById('dropZoneTitle');
        const fileInput = document.getElementById('fileInput');
        const uploadForm = document.getElementById('uploadForm');
        const queueContainer = document.getElementById('fileQueueContainer');
        const queueSummary = document.getElementById('fileQueueSummary');
        const queueList = document.getElementById('fileQueueList');
        const clearQueueBtn = document.getElementById('clearQueueBtn');
        const warningBox = document.getElementById('dropWarning');
        const submitBtn = document.getElementById('uploadSubmitBtn');
        const submitText = document.getElementById('uploadSubmitText');

        let queuedFiles = [];
        let isSubmitting = false;

        function formatBytes(bytes) {
            if (bytes < 1024 * 1024) {
                return (bytes / 1024).toFixed(1) + ' KB';
            }
            return (bytes / 1024 / 1024).toFixed(2) + ' MB';
        }

        function showWarning(message) {
            if (!message) {
                warningBox.classList.add('d-none');
                warningBox.textContent = '';
                return;
            }
            warningBox.textContent = message;
            warningBox.classList.remove('d-none');
        }

        function syncInputFiles() {
            if (typeof DataTransfer === 'undefined') return false;
            const dt = new DataTransfer();
            queuedFiles.forEach(file => dt.items.add(file));
            fileInput.files = dt.files;
            return true;
        }

        function renderQueue() {
            queueList.innerHTML = '';

            if (queuedFiles.length === 0) {
                queueContainer.classList.add('d-none');
                submitText.textContent = 'Upload & Auto Split (4 to 1)';
                return;
            }

            let totalBytes = 0;
            queuedFiles.forEach((file, idx) => {
                totalBytes += file.size;

                const row = document.createElement('div');
                row.className = 'queue-item';

                const left = document.createElement('div');
                left.className = 'd-flex align-items-center gap-2 text-truncate';
                left.style.minWidth = '0';

                const badge = document.createElement('span');
                badge.className = 'badge bg-light text-primary border';
                badge.textContent = (idx + 1).toString();

                const nameEl = document.createElement('span');
                nameEl.className = 'fw-semibold text-dark text-truncate';
                nameEl.textContent = file.name;

                const sizeEl = document.createElement('span');
                sizeEl.className = 'text-muted flex-shrink-0';
                sizeEl.textContent = '(' + formatBytes(file.size) + ')';

                left.appendChild(badge);
                left.appendChild(nameEl);
                left.appendChild(sizeEl);

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'queue-item-remove';
                removeBtn.title = 'Remove file';
                removeBtn.textContent = '×';
                removeBtn.addEventListener('click', function () {
                    queuedFiles.splice(idx, 1);
                    if (queuedFiles.length === 0) {
                        fileInput.value = '';
                    }
                    syncInputFiles();
                    renderQueue();
                    if (queuedFiles.length === 0) showWarning('');
                });

                row.appendChild(left);
                row.appendChild(removeBtn);
                queueList.appendChild(row);
            });

            const fileWord = queuedFiles.length === 1 ? 'File' : 'Files';
            queueSummary.textContent = `Selected: ${queuedFiles.length} PDF ${fileWord} (${formatBytes(totalBytes)})`;
            submitText.textContent = `Upload & Auto Split (${queuedFiles.length} ${fileWord})`;
            queueContainer.classList.remove('d-none');

            if (totalBytes > MAX_BATCH_BYTES) {
                showWarning(`Total batch size (${formatBytes(totalBytes)}) exceeds the 100 MB limit. Remove some files or upload in smaller batches.`);
            }
        }

        function addFiles(fileList) {
            if (!fileList || fileList.length === 0) return;

            dropZone.classList.remove('dropzone-error');
            const skippedNonPdf = [];

            Array.from(fileList).forEach(file => {
                const isPdf = file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf';
                if (!isPdf) {
                    skippedNonPdf.push(file.name);
                    return;
                }

                const exists = queuedFiles.some(q =>
                    q.name.toLowerCase() === file.name.toLowerCase() &&
                    q.size === file.size &&
                    q.lastModified === file.lastModified);

                if (!exists) {
                    queuedFiles.push(file);
                }
            });

            syncInputFiles();
            renderQueue();

            if (skippedNonPdf.length > 0) {
                showWarning(`Ignored ${skippedNonPdf.length} non-PDF file(s): ${skippedNonPdf.join(', ')}`);
            } else {
                showWarning('');
            }
        }

        // Prevent browser from opening dropped PDFs outside dropzone
        window.addEventListener('dragover', function (e) {
            e.preventDefault();
        });
        window.addEventListener('drop', function (e) {
            e.preventDefault();
        });

        dropZone.addEventListener('dragenter', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.add('dropzone-active');
            dropZoneTitle.textContent = 'Drop Your PDF Files Here...';
        });

        dropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (e.dataTransfer) {
                e.dataTransfer.dropEffect = 'copy';
            }
            dropZone.classList.add('dropzone-active');
        });

        dropZone.addEventListener('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('dropzone-active');
            dropZoneTitle.textContent = 'Select or Drag & Drop MPS PDF Files Here';
        });

        dropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('dropzone-active');
            dropZoneTitle.textContent = 'Select or Drag & Drop MPS PDF Files Here';

            if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                addFiles(e.dataTransfer.files);
            }
        });

        fileInput.addEventListener('change', function () {
            if (this.files && this.files.length > 0) {
                addFiles(this.files);
            }
        });

        clearQueueBtn.addEventListener('click', function () {
            queuedFiles = [];
            fileInput.value = '';
            syncInputFiles();
            renderQueue();
            showWarning('');
        });

        uploadForm.addEventListener('submit', function (e) {
            if (isSubmitting) {
                e.preventDefault();
                return;
            }

            if (queuedFiles.length === 0) {
                e.preventDefault();
                dropZone.classList.add('dropzone-error');
                showWarning('Please select or drag & drop at least 1 PDF file before uploading.');
                return;
            }

            const totalBytes = queuedFiles.reduce((sum, f) => sum + f.size, 0);
            if (totalBytes > MAX_BATCH_BYTES) {
                e.preventDefault();
                showWarning(`Total batch size (${formatBytes(totalBytes)}) exceeds the 100 MB limit. Please upload fewer files per batch.`);
                return;
            }

            syncInputFiles();
            isSubmitting = true;
            submitBtn.style.pointerEvents = 'none';
            submitBtn.classList.add('opacity-75');
            const fileWord = queuedFiles.length === 1 ? 'File' : 'Files';
            submitText.textContent = `Processing ${queuedFiles.length} PDF ${fileWord}...`;

            if (!document.getElementById('uploadShimmerBar')) {
                const bar = document.createElement('div');
                bar.id = 'uploadShimmerBar';
                bar.className = 'mps-skeleton mt-3';
                bar.style.height = '6px';
                bar.style.width = '100%';
                uploadForm.appendChild(bar);
            }
        });
    })();
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <text>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof celebrateMpsAvatar === 'function') celebrateMpsAvatar();
        });
        </text>
    }
</script>
}
