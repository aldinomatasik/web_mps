@page
@using WebMPS.Models
@using WebMPS.Extensions
@model WebMPS.Pages.SlipsModel
@{
    ViewData["Title"] = "Slip MPS";
    ViewData["Subtitle"] = "";
    bool isToUser = User.IsInRole(AppRoles.TO);
    bool isAdmin = User.IsInRole(AppRoles.Admin);
}

<form id="antiForgeryForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Filter Bar: Compact Single-Row Toolbar (Auto-responsive, never wraps awkwardly) -->
<div class="filter-bar no-print py-2 px-3 mb-3 shadow-xs" style="padding: 10px 16px; margin-bottom: 16px; border-radius: 10px;">
    <form method="get" class="w-100 d-flex flex-wrap flex-xl-nowrap align-items-center gap-2">
        <!-- Hidden Scoped TO if active -->
        @if (!string.IsNullOrEmpty(Model.To))
        {
            <input type="hidden" name="To" value="@Model.To" />
        }

        <!-- Filter Date: Interactive Calendar Date Picker -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">Date:</span>
            <div class="input-group input-group-sm" style="width: 145px;">
                <input type="date" 
                       id="filterDate"
                       name="Date" 
                       class="form-control form-control-sm px-2" 
                       value="@Model.FormattedDateInput" 
                       onchange="this.form.submit()" 
                       title="Select date (yesterday, today, tomorrow, etc.)" 
                       style="cursor: pointer; height: 31px;" />
                @if (!string.IsNullOrEmpty(Model.FormattedDateInput))
                {
                    <button type="button" 
                            class="btn btn-outline-secondary btn-sm px-2" 
                            onclick="clearDateFilter(this.form)" 
                            title="Show all dates">✕</button>
                }
            </div>
        </div>

        <!-- Filter Planner -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">Planner:</span>
            <select name="Planner" class="form-select form-select-sm" style="width: 140px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.Planner) || Model.Planner == "ALL")">All Planners</option>
                @foreach (var p in Model.DistinctPlanners)
                {
                    <option value="@p" selected="@(Model.Planner == p)">@p</option>
                }
            </select>
        </div>

        <!-- Filter Category (Jenis MPS: 1A, 1B, 2) -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="fw-bold text-dark small text-nowrap">Category:</span>
            <select name="Category" class="form-select form-select-sm" style="width: 105px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.Category) || Model.Category == "ALL")">All Types</option>
                @foreach (var c in Model.DistinctCategories)
                {
                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                }
            </select>
        </div>

        <!-- Filter Status -->
        <div class="d-flex align-items-center gap-1 flex-shrink-0">
            <span class="text-muted small text-nowrap">Status:</span>
            <select name="Status" class="form-select form-select-sm" style="width: 100px;" onchange="this.form.submit()">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "ALL")">All Status</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
            </select>
        </div>

        <!-- Search Box (Integrated input-group, flexible width) -->
        <div class="input-group input-group-sm flex-grow-1 ms-auto" style="min-width: 150px; max-width: 280px;">
            <input type="text" name="Search" class="form-control form-control-sm" placeholder="Search slip, part, model..." value="@Model.Search" />
            <button type="submit" class="btn btn-primary btn-sm px-2 d-inline-flex align-items-center" style="background: #0284c7;" title="Search">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
            @if (!string.IsNullOrEmpty(Model.Search) || 
                 !string.Equals(Model.Date, Model.TodayDate, StringComparison.OrdinalIgnoreCase) || 
                 (!string.IsNullOrEmpty(Model.Planner) && Model.Planner != "ALL") ||
                 (!string.IsNullOrEmpty(Model.Category) && Model.Category != "ALL") ||
                 (!string.IsNullOrEmpty(Model.Status) && Model.Status != "ALL"))
            {
                <a asp-page="/Slips" class="btn btn-outline-secondary btn-sm px-2" title="Reset All Filters (Back to Today)">✕</a>
            }
        </div>
    </form>
</div>

<!-- Quick Info Strip -->
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted small">Showing <strong>@Model.Slips.Count</strong> of <strong>@Model.TotalSlips</strong> slips</span>
        @if (!string.IsNullOrEmpty(Model.To) && Model.To != "ALL")
        {
            <span class="badge bg-light text-dark border">TO: @Model.To</span>
        }
        @if (!string.IsNullOrEmpty(Model.Date) && Model.Date != "ALL")
        {
            <span class="badge bg-light text-primary border">Date: @Model.Date</span>
        }
        @if (!string.IsNullOrEmpty(Model.Planner) && Model.Planner != "ALL")
        {
            <span class="badge bg-light text-dark border">Planner: @Model.Planner</span>
        }
        @if (!string.IsNullOrEmpty(Model.Category) && Model.Category != "ALL")
        {
            <span class="badge bg-light text-primary border fw-bold">Category: @Model.Category</span>
        }
        @if (!string.IsNullOrEmpty(Model.Status) && Model.Status != "ALL")
        {
            <span class="badge bg-light text-secondary border">Status: @Model.Status</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a href="/download/all" target="_blank" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download All Slips (PDF)
        </a>
    </div>
</div>

<!-- Batch Approval & Select All Action Bar -->
@if (Model.Slips.Any(s => s.ApprovalStatus != "Approved"))
{
    var pendingSlips = Model.Slips.Where(s => s.ApprovalStatus != "Approved").ToList();
    var currentPendingPlanners = pendingSlips
        .Where(s => !string.IsNullOrWhiteSpace(s.Planner))
        .Select(s => s.Planner)
        .Distinct()
        .OrderBy(p => p)
        .ToList();

    <div class="card border mb-4 shadow-sm no-print" id="batchActionBar" style="background: #f8fafc; border-radius: 10px; border-color: #cbd5e1 !important;">
        <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <!-- Left: Master Checkbox & Planners Toggle -->
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="form-check m-0 d-inline-flex align-items-center">
                    <input class="form-check-input" type="checkbox" id="masterSelectAll" onchange="toggleSelectAll(this)" style="cursor: pointer; width: 1.15rem; height: 1.15rem;" />
                    <label class="form-check-label fw-bold text-dark small ms-2" for="masterSelectAll" style="cursor: pointer;">
                        Select All (<span id="totalPendingOnPage">@pendingSlips.Count</span> Pending)
                    </label>
                </div>

                @if (currentPendingPlanners.Count > 1)
                {
                    <div class="vr d-none d-md-block" style="height: 22px;"></div>
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <span class="text-muted small me-1">Toggle Planner:</span>
                        @foreach (var pl in currentPendingPlanners)
                        {
                            var count = pendingSlips.Count(s => s.Planner == pl);
                            <button type="button" 
                                    class="btn btn-xs btn-outline-secondary py-0 px-2 rounded-pill planner-toggle-btn"
                                    style="font-size: 0.73rem;"
                                    data-planner="@pl"
                                    onclick="togglePlannerSelection('@pl', this)"
                                    title="Click to select / deselect all @pl slips">
                                @pl (@count)
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Right: Counter & Batch Approve Button -->
            <div class="d-flex align-items-center gap-2 ms-auto">
                <span class="text-muted small">Selected: <strong id="selectedCounterText" class="text-dark">0</strong> slip(s)</span>
                <button type="button" 
                        id="btnBatchApprove" 
                        class="btn btn-sm btn-success fw-bold px-3 d-inline-flex align-items-center gap-2"
                        disabled
                        onclick="executeBatchApprove()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Approve Selected (<span id="btnBatchCount">0</span>)</span>
                </button>
            </div>
        </div>
    </div>
}

@if (!Model.Slips.Any())
{
    <div class="white-card text-center py-5">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" class="mb-3">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <h5 class="fw-bold text-dark mb-1">No Material Picking Slips Found</h5>
        <p class="text-muted small mb-3">Try adjusting your filter criteria or search keyword.</p>
        <a asp-page="/Slips" asp-route-Date="ALL" class="btn btn-sm btn-primary" style="background: #0284c7;">View All Slips</a>
    </div>
}
else
{
    <!-- Grid of Individual Slips (1-by-1) -->
    <div class="row">
        @foreach (var slip in Model.Slips)
        {
            <div class="col-xl-6 col-12 mb-4">
                <div class="card border h-100 shadow-sm bg-white mps-slip-card" id="slip-card-@slip.Id">
                    <!-- Slip Card Header Bar -->
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2 px-3 no-print">
                        <div class="d-flex align-items-center gap-2">
                            @if (slip.ApprovalStatus != "Approved")
                            {
                                <div class="form-check m-0 d-inline-flex align-items-center me-1" id="wrap-chk-@slip.Id">
                                    <input class="form-check-input slip-select-chk" 
                                           type="checkbox" 
                                           value="@slip.Id" 
                                           data-planner="@slip.Planner" 
                                           data-category="@slip.Tag"
                                           id="chk-@slip.Id" 
                                           onchange="onSlipSelectionChange()"
                                           style="cursor: pointer; width: 1.1rem; height: 1.1rem;" />
                                </div>
                            }
                            <span class="badge bg-secondary" style="font-size: 0.7rem;">Page @slip.OriginalPage (@slip.QuadrantLabel)</span>
                            <span class="fw-bold text-dark font-monospace">#@slip.SlipNumber</span>
                            @if (slip.ApprovalStatus == "Approved")
                            {
                                <span class="status-badge approved" id="badge-@slip.Id">✓ Approved</span>
                            }
                            else
                            {
                                <span class="status-badge pending" id="badge-@slip.Id">● Pending</span>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/download/slip/@slip.Id" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size: 0.75rem; padding: 2px 8px;">
                                Original PDF
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem; padding: 2px 8px;" onclick="printSlip('@slip.Id')">
                                Print
                            </button>
                        </div>
                    </div>

                    <!-- Slip Card Body: Exact Document Representation -->
                    <div class="card-body p-3 d-flex flex-column justify-content-between" id="slip-print-@slip.Id">
                        <div class="mps-slip-paper">
                            <!-- Header Row: Title & Boxed Tag -->
                            <div class="mps-header-row">
                                <div class="mps-title">@slip.Title</div>
                                <div class="mps-tag-box">@slip.Tag</div>
                            </div>

                            <!-- Metadata Grid: 2 Columns -->
                            <div class="mps-meta-grid">
                                <div class="mps-meta-item">
                                    <span class="mps-label">PLANNER:</span>
                                    <span class="mps-val">@slip.Planner</span>
                                </div>
                                <div></div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">SLIP NUMBER:</span>
                                    <span class="mps-val font-monospace">@slip.SlipNumber</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">SUPPLY DATE:</span>
                                    <span class="mps-val">@slip.SupplyDate</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">FROM:</span>
                                    <span class="mps-val">@slip.FromLocation</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">REQ. DATE:</span>
                                    <span class="mps-val">@slip.ReqDate</span>
                                </div>
                                <div class="mps-meta-item">
                                    <span class="mps-label">TO:</span>
                                    <span class="mps-val">@slip.ToLocation</span>
                                </div>
                                <div></div>
                            </div>

                            <!-- Primary Part Section Table -->
                            <table class="mps-section-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;">PART CODE</th>
                                        <th style="width: 45%;">DESCRIPTION</th>
                                        <th style="width: 18%; text-align: right;">QTY</th>
                                        <th style="width: 12%; text-align: right;">UNIT</th>
                                    </tr>
                                    <tr class="mps-sub-head">
                                        <th>VMI &nbsp;&nbsp; VENDOR</th>
                                        <th>VENDOR DESCRIPTION</th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@slip.PartCode</td>
                                        <td>@slip.PartDescription</td>
                                        <td style="text-align: right;">@slip.Qty.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        <td style="text-align: right;">@slip.Unit</td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Pegged Orders Section Table -->
                            <table class="mps-section-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;">ORDER</th>
                                        <th style="width: 45%;">PEGGED MATERIAL</th>
                                        <th style="width: 18%; text-align: right;">REQ</th>
                                        <th style="width: 12%; text-align: right;">UNIT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in slip.PeggedOrders)
                                    {
                                        <tr>
                                            <td>@order.OrderNumber</td>
                                            <td>@order.PeggedMaterial</td>
                                            <td style="text-align: right;">@order.ReqQty.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td style="text-align: right;">@order.Unit</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <!-- Dual Signature Boxes (Exact Border Structure) -->
                            <div class="mps-sig-container">
                                <div class="mps-sig-box">
                                    <div class="mps-sig-title">DELIVERY SIGNATURE</div>
                                    <div class="mps-sig-content">
                                        <div class="mps-sig-name" title="@(string.IsNullOrEmpty(slip.DeliverySignature) ? (slip.IsScanned ? slip.Planner : "") : slip.DeliverySignature)">
                                            @(string.IsNullOrEmpty(slip.DeliverySignature) ? (slip.IsScanned ? slip.Planner : "") : slip.DeliverySignature)
                                        </div>
                                        <div class="mps-sig-date">
                                            @if (!string.IsNullOrEmpty(slip.DeliverySignature) || slip.IsScanned)
                                            {
                                                <span>@((slip.ScannedAt ?? slip.ApprovedAt)?.ToString("dd/MM/yyyy"))</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="mps-sig-box">
                                    <div class="mps-sig-title">RECEIVER SIGNATURE</div>
                                    <div class="mps-sig-content">
                                        <div class="mps-sig-name" id="rec-sig-@slip.Id" title="@slip.ReceiverSignature">@slip.ReceiverSignature</div>
                                        <div class="mps-sig-date" id="rec-date-@slip.Id">
                                            @if (!string.IsNullOrEmpty(slip.ReceiverSignature))
                                            {
                                                <span>@slip.ApprovedAt?.ToString("dd/MM/yyyy")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Barcode Section -->
                            <div class="mps-barcode-container">
                                @Html.Raw(WebMPS.Services.BarcodeHelper.GenerateSvgBarcode(slip.Barcode, 26))
                                <div class="mps-barcode-text">@slip.SlipNumber</div>
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center no-print">
                            <span class="text-muted small" id="footer-status-@slip.Id">
                                @if (slip.ApprovalStatus == "Approved")
                                {
                                    <span class="text-success fw-bold">✓ Approved by @slip.ApprovedBy (@slip.ApprovedAt?.ToString("dd/MM/yy"))</span>
                                }
                                else
                                {
                                    <span>Pending Handover</span>
                                }
                            </span>
                            @if (slip.ApprovalStatus != "Approved")
                            {
                                <form method="post" asp-page-handler="QuickApprove" id="approve-form-@slip.Id" class="d-inline" onsubmit="return quickApproveAjax(event, '@slip.Id', this);">
                                    <input type="hidden" name="slipId" value="@slip.Id" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold px-3">
                                        ✓ Approve
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center my-4 no-print">
            <ul class="pagination pagination-sm shadow-sm">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Slips" 
                       asp-route-PageIndex="@(Model.PageIndex - 1)" 
                       asp-route-Search="@Model.Search" 
                       asp-route-To="@Model.To" 
                       asp-route-Date="@Model.Date"
                       asp-route-Planner="@Model.Planner" 
                       asp-route-Category="@Model.Category" 
                       asp-route-Status="@Model.Status">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                    {
                        <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                            <a class="page-link" asp-page="/Slips" 
                               asp-route-PageIndex="@i" 
                               asp-route-Search="@Model.Search" 
                               asp-route-To="@Model.To" 
                               asp-route-Date="@Model.Date"
                               asp-route-Planner="@Model.Planner" 
                               asp-route-Category="@Model.Category" 
                               asp-route-Status="@Model.Status">@i</a>
                        </li>
                    }
                    else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/Slips" 
                       asp-route-PageIndex="@(Model.PageIndex + 1)" 
                       asp-route-Search="@Model.Search" 
                       asp-route-To="@Model.To" 
                       asp-route-Date="@Model.Date"
                       asp-route-Planner="@Model.Planner" 
                       asp-route-Category="@Model.Category" 
                       asp-route-Status="@Model.Status">Next</a>
                </li>
            </ul>
        </nav>
    }
}

<!-- Modal Konfirmasi Batch Approval (Proper Modern Popup) -->
<div class="modal fade" id="batchApproveModal" tabindex="-1" aria-labelledby="batchApproveModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-body p-4 text-center">
                <!-- Icon Circle -->
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" 
                     style="width: 68px; height: 68px; background: #e0f2fe; border-radius: 50%; color: #0284c7; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.18);">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <path d="M9 15l2 2 4-4"></path>
                    </svg>
                </div>
                
                <h5 class="fw-bold text-dark mb-2" id="batchApproveModalLabel">Batch Approval Confirmation</h5>
                <p class="text-secondary small mb-3">
                    Are you sure you want to approve <span id="modalSlipCountBadge" class="badge bg-primary px-2 py-1 fs-6">0</span> selected material slips?
                </p>

                <div class="border py-2 px-3 text-start small mb-4" style="border-radius: 10px; background: #f8fafc; border-color: #e2e8f0;">
                    <div class="text-muted" style="font-size: 0.78rem;">Receiver signature (*RECEIVER SIGNATURE*) will be applied:</div>
                    <div class="fw-bold text-dark mt-1 d-flex align-items-center gap-1">
                        <span class="text-success">✓</span> RECEIVER: <span class="text-primary">@(User.GetDisplayName() ?? User.Identity?.Name)</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem; margin-top: 2px;">
                        Date: <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light border px-4 py-2 fw-semibold text-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-success px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" id="btnConfirmBatchApprove" onclick="submitConfirmedBatchApprove()" style="border-radius: 8px; background: #16a34a; border-color: #16a34a;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Yes, Approve Now
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
<script>
    // -------------------------------------------------------------
    // BATCH APPROVAL & SELECTION SCRIPTS
    // -------------------------------------------------------------
    function onSlipSelectionChange() {
        const checkboxes = document.querySelectorAll('.slip-select-chk');
        const checked = document.querySelectorAll('.slip-select-chk:checked');
        const count = checked.length;
        
        const counterText = document.getElementById('selectedCounterText');
        const btnBatchCount = document.getElementById('btnBatchCount');
        const btnBatch = document.getElementById('btnBatchApprove');
        const master = document.getElementById('masterSelectAll');
        
        if (counterText) counterText.textContent = count;
        if (btnBatchCount) btnBatchCount.textContent = count;
        if (btnBatch) btnBatch.disabled = count === 0;
        
        if (master) {
            master.checked = checkboxes.length > 0 && checked.length === checkboxes.length;
            master.indeterminate = count > 0 && count < checkboxes.length;
        }

        // Highlight card border on check
        checkboxes.forEach(function(chk) {
            const card = document.getElementById('slip-card-' + chk.value);
            if (card) {
                if (chk.checked) {
                    card.style.borderColor = '#0284c7';
                    card.style.boxShadow = '0 0 0 2px rgba(2, 132, 199, 0.2)';
                } else {
                    card.style.borderColor = '';
                    card.style.boxShadow = '';
                }
            }
        });

        // Update planner buttons active state
        document.querySelectorAll('.planner-toggle-btn').forEach(function(btn) {
            const pl = btn.getAttribute('data-planner');
            const plChks = document.querySelectorAll(`.slip-select-chk[data-planner="${pl}"]`);
            const plChecked = document.querySelectorAll(`.slip-select-chk[data-planner="${pl}"]:checked`);
            if (plChks.length > 0 && plChecked.length === plChks.length) {
                btn.classList.add('btn-primary', 'text-white');
                btn.classList.remove('btn-outline-secondary');
            } else {
                btn.classList.remove('btn-primary', 'text-white');
                btn.classList.add('btn-outline-secondary');
            }
        });
    }

    function toggleSelectAll(master) {
        const isChecked = master.checked;
        document.querySelectorAll('.slip-select-chk').forEach(function(chk) {
            chk.checked = isChecked;
        });
        onSlipSelectionChange();
    }

    function togglePlannerSelection(plannerName, btn) {
        const plChks = document.querySelectorAll(`.slip-select-chk[data-planner="${plannerName}"]`);
        if (plChks.length === 0) return;
        
        // If all of this planner's slips are already checked, uncheck them. Otherwise, check all of them.
        const allChecked = Array.from(plChks).every(c => c.checked);
        const targetState = !allChecked;
        plChks.forEach(function(chk) {
            chk.checked = targetState;
        });
        onSlipSelectionChange();
    }

    function executeBatchApprove() {
        const checked = Array.from(document.querySelectorAll('.slip-select-chk:checked'));
        if (checked.length === 0) return;

        const countBadge = document.getElementById('modalSlipCountBadge');
        if (countBadge) countBadge.textContent = checked.length;

        const modalEl = document.getElementById('batchApproveModal');
        if (modalEl && window.bootstrap && window.bootstrap.Modal) {
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        } else {
            submitConfirmedBatchApprove();
        }
    }

    async function submitConfirmedBatchApprove() {
        const checked = Array.from(document.querySelectorAll('.slip-select-chk:checked'));
        if (checked.length === 0) return;

        const modalEl = document.getElementById('batchApproveModal');
        const modalInstance = (modalEl && window.bootstrap && window.bootstrap.Modal) 
            ? bootstrap.Modal.getInstance(modalEl) 
            : null;

        const btnConfirm = document.getElementById('btnConfirmBatchApprove');
        const originalConfirmHtml = btnConfirm ? btnConfirm.innerHTML : '';
        if (btnConfirm) {
            btnConfirm.disabled = true;
            btnConfirm.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Approving...`;
        }

        const btnBatch = document.getElementById('btnBatchApprove');
        const originalBatchHtml = btnBatch ? btnBatch.innerHTML : '';
        if (btnBatch) {
            btnBatch.disabled = true;
            btnBatch.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Processing...`;
        }

        const formData = new FormData();
        checked.forEach(function(chk) {
            formData.append('slipIds', chk.value);
        });

        try {
            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value;
            const resp = await fetch('?handler=BatchApproveAjax', {
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token } : {},
                body: formData
            });

            if (!resp.ok) {
                if (modalInstance) modalInstance.hide();
                const fallbackForm = document.createElement('form');
                fallbackForm.method = 'POST';
                fallbackForm.action = '?handler=BatchApprove';
                checked.forEach(function(chk) {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = 'slipIds';
                    hidden.value = chk.value;
                    fallbackForm.appendChild(hidden);
                });
                if (token) {
                    const tokenHidden = document.createElement('input');
                    tokenHidden.type = 'hidden';
                    tokenHidden.name = '__RequestVerificationToken';
                    tokenHidden.value = token;
                    fallbackForm.appendChild(tokenHidden);
                }
                document.body.appendChild(fallbackForm);
                fallbackForm.submit();
                return;
            }

            const data = await resp.json();
            if (modalInstance) modalInstance.hide();

            if (data.success && data.approvedIds) {
                data.approvedIds.forEach(function(slipId) {
                    // Update badge
                    const badge = document.getElementById('badge-' + slipId);
                    if (badge) {
                        badge.className = 'status-badge approved';
                        badge.textContent = '✓ Approved';
                    }

                    // Update receiver signature
                    const recSig = document.getElementById('rec-sig-' + slipId);
                    if (recSig) {
                        recSig.textContent = data.approvedBy;
                        recSig.title = data.approvedBy;
                        if (window.fitMpsSignatureNames) {
                            window.fitMpsSignatureNames(recSig.parentElement);
                        }
                    }

                    const recDate = document.getElementById('rec-date-' + slipId);
                    if (recDate) {
                        recDate.innerHTML = `<span>${data.approvedDate || ''}</span>`;
                    }

                    // Update footer status
                    const footerStatus = document.getElementById('footer-status-' + slipId);
                    if (footerStatus) {
                        footerStatus.innerHTML = `<span class="text-success fw-bold">✓ Approved by ${data.approvedBy} (${data.approvedDate})</span>`;
                    }

                    // Remove checkbox
                    const chkWrap = document.getElementById('wrap-chk-' + slipId);
                    if (chkWrap) chkWrap.remove();

                    // Remove single approve button form
                    const singleForm = document.getElementById('approve-form-' + slipId);
                    if (singleForm) singleForm.remove();

                    // Highlight card
                    const card = document.getElementById('slip-card-' + slipId);
                    if (card) {
                        card.style.borderColor = '';
                        card.style.boxShadow = '';
                        card.classList.add('mps-row-flash');
                    }
                });

                // Update global counters
                if (typeof updateGlobalCounters === 'function' && data.stats) {
                    updateGlobalCounters(data.stats);
                }
                if (typeof celebrateMpsAvatar === 'function') {
                    celebrateMpsAvatar();
                }

                // Show modern toast popup
                showMpsToast(`✓ Successfully approved ${data.approvedIds.length} material slips!`, 'success');

                // Hide or refresh batch bar
                const remainingChks = document.querySelectorAll('.slip-select-chk');
                if (remainingChks.length === 0) {
                    const batchBar = document.getElementById('batchActionBar');
                    if (batchBar) batchBar.remove();
                } else {
                    const totalPendingOnPage = document.getElementById('totalPendingOnPage');
                    if (totalPendingOnPage) totalPendingOnPage.textContent = remainingChks.length;
                    onSlipSelectionChange();
                }
            } else {
                showMpsToast(data.message || 'Failed to approve selected slips.', 'error');
            }
        } catch (err) {
            console.error(err);
            if (modalInstance) modalInstance.hide();
            showMpsToast('An error occurred: ' + err.message, 'error');
        } finally {
            if (btnConfirm) {
                btnConfirm.disabled = false;
                btnConfirm.innerHTML = originalConfirmHtml;
            }
            if (btnBatch) {
                btnBatch.disabled = false;
                btnBatch.innerHTML = originalBatchHtml;
                onSlipSelectionChange();
            }
        }
    }

    function showMpsToast(message, type) {
        const toastEl = document.getElementById('mpsModernToast');
        if (!toastEl) {
            return;
        }
        const toastMsg = document.getElementById('toastMessage');
        const toastIcon = document.getElementById('toastIcon');

        if (type === 'success') {
            toastEl.className = 'toast align-items-center border-0 shadow-lg text-white bg-success';
            toastIcon.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
        } else {
            toastEl.className = 'toast align-items-center border-0 shadow-lg text-white bg-danger';
            toastIcon.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
        }

        toastMsg.textContent = message;
        if (window.bootstrap && window.bootstrap.Toast) {
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
        }
    }

    // -------------------------------------------------------------
    // SINGLE QUICK APPROVE SCRIPT
    // -------------------------------------------------------------
    async function quickApproveAjax(event, slipId, form) {
        event.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = 'Saving...';

        try {
            const resp = await fetch('?handler=QuickApproveAjax', {
                method: 'POST',
                body: new FormData(form)
            });

            if (!resp.ok) {
                form.submit();
                return false;
            }

            const data = await resp.json();
            if (data.success) {
                const badge = document.getElementById('badge-' + slipId);
                if (badge) {
                    badge.className = 'status-badge approved';
                    badge.textContent = '✓ Approved';
                }

                const recSig = document.getElementById('rec-sig-' + slipId);
                if (recSig) {
                    recSig.textContent = data.approvedBy;
                    recSig.title = data.approvedBy;
                    if (window.fitMpsSignatureNames) {
                        window.fitMpsSignatureNames(recSig.parentElement);
                    }
                }

                const recDate = document.getElementById('rec-date-' + slipId);
                if (recDate) {
                    const span = document.createElement('span');
                    span.textContent = data.approvedDate || '';
                    recDate.innerHTML = '';
                    recDate.appendChild(span);
                }

                const footerStatus = document.getElementById('footer-status-' + slipId);
                if (footerStatus) {
                    const msgSpan = document.createElement('span');
                    msgSpan.className = 'text-success fw-bold';
                    msgSpan.textContent = `✓ Approved by ${data.approvedBy} (${data.approvedDate})`;
                    footerStatus.innerHTML = '';
                    footerStatus.appendChild(msgSpan);
                }

                // Remove checkbox
                const chkWrap = document.getElementById('wrap-chk-' + slipId);
                if (chkWrap) chkWrap.remove();

                form.remove();

                const card = document.getElementById('slip-card-' + slipId);
                if (card) {
                    card.style.borderColor = '';
                    card.style.boxShadow = '';
                    card.classList.add('mps-row-flash');
                }

                if (typeof updateGlobalCounters === 'function') {
                    updateGlobalCounters(data.stats);
                }
                if (typeof celebrateMpsAvatar === 'function') {
                    celebrateMpsAvatar();
                }

                showMpsToast('✓ Material slip successfully approved!', 'success');

                // Refresh batch bar counts
                const remainingChks = document.querySelectorAll('.slip-select-chk');
                if (remainingChks.length === 0) {
                    const batchBar = document.getElementById('batchActionBar');
                    if (batchBar) batchBar.remove();
                } else {
                    const totalPendingOnPage = document.getElementById('totalPendingOnPage');
                    if (totalPendingOnPage) totalPendingOnPage.textContent = remainingChks.length;
                    onSlipSelectionChange();
                }
            } else {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        } catch (err) {
            console.error(err);
            form.submit();
        }

        return false;
    }

    function clearDateFilter(form) {
        if (!form) form = document.querySelector('.filter-bar form');
        const dateInput = form.querySelector('input[name="Date"]');
        if (dateInput) {
            dateInput.value = '';
        }
        form.submit();
    }

    function printSlip(slipId) {
        var slipEl = document.getElementById('slip-print-' + slipId);
        if (!slipEl) return;

        var oldFrame = document.getElementById('mps-print-frame');
        if (oldFrame) oldFrame.remove();

        var iframe = document.createElement('iframe');
        iframe.id = 'mps-print-frame';
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = '0';
        document.body.appendChild(iframe);

        var styles = Array.from(document.querySelectorAll('style')).map(function (s) { return s.outerHTML; }).join('');
        var doc = iframe.contentWindow.document;

        doc.open();
        doc.write('<!DOCTYPE html><html><head><title></title>' + styles +
            '<style>' +
            '@@page { size: auto; margin: 0mm !important; }' +
            '* { box-sizing: border-box !important; }' +
            'html, body { margin: 0 !important; padding: 0 !important; background: #ffffff !important; width: 100% !important; }' +
            'body { padding: 12mm 14mm !important; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif !important; }' +
            '.mps-slip-paper { width: 100% !important; max-width: 560px !important; margin: 0 auto !important; padding: 0 !important; border: none !important; box-shadow: none !important; }' +
            '</style></head><body>' + slipEl.outerHTML + '</body></html>');
        doc.close();

        setTimeout(function () {
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
        }, 250);
    }
</script>
}
